{
  "name": "sipg-acceptance-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"python3 -m uvicorn backend.app.main:app --reload --host 0.0.0.0 --port 8787\" \"npm run dev --prefix frontend\"",
    "build": "vite build --config frontend/vite.config.js",
    "start": "python3 -m uvicorn backend.app.main:app --host 0.0.0.0 --port ${PORT:-8787}"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "vite": "^7.1.5"
  }
}
